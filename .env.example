# OpenAI-compatible endpoint for chat, tool calling, and dense embeddings.
# Leave OPENAI_BASE_URL empty to use api.openai.com directly. Set it to a
# RouterAI gateway to run any of its models instead, for example:
#   OPENAI_BASE_URL=https://routerai.ru/api/v1
#   OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
#   OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# The chat model must support tools and response_format; the embedding model
# must produce OPENAI_EMBEDDING_DIMENSIONS-sized vectors.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Qdrant hybrid index: dense OpenAI embeddings + FastEmbed BM25, fused with RRF.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_resumes
QDRANT_PREFETCH_LIMIT=30

# SQLite metadata and locally stored uploaded PDFs.
DATABASE_URL=sqlite+aiosqlite:///./data/hr_assistant.db
STORAGE_DIR=./storage/resumes
MAX_UPLOAD_BYTES=15728640

# Optional SMTP delivery. A message is sent only after HR approves its draft.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Langfuse tracing is disabled when either key is empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

APP_NAME=HR Assistant API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
