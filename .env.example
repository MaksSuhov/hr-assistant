# OpenAI-compatible endpoint for chat, tool calling, and dense embeddings.
# The model ids below come from the RouterAI gateway, so point OPENAI_BASE_URL
# at it. To use api.openai.com directly instead, leave OPENAI_BASE_URL empty and
# pick an OpenAI model id (e.g. gpt-4.1-mini).
#   OPENAI_BASE_URL=https://routerai.ru/api/v1
#   OPENAI_CHAT_MODEL=qwen/qwen3.7-flash
#   OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
# The chat model must support tools and response_format; the embedding model
# must produce OPENAI_EMBEDDING_DIMENSIONS-sized vectors.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=qwen/qwen3.7-flash
SEARCH_ENHANCEMENT_MODEL=qwen/qwen3.7-flash
HYDE_ENABLED=true
RERANKING_ENABLED=true
RERANKING_CANDIDATE_POOL=30
# Reasoning/thinking models (e.g. qwen3.7) block for seconds before the first
# visible token. Leave false to send reasoning={"enabled": false}; set true to
# keep the model's hidden reasoning. Not honored by every gateway.
CHAT_REASONING_ENABLED=false
EVAL_JUDGE_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Qdrant hybrid index: dense OpenAI embeddings + FastEmbed BM25, fused with RRF.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hr_resumes
QDRANT_PREFETCH_LIMIT=30

# SQLite metadata and locally stored uploaded PDFs.
DATABASE_URL=sqlite+aiosqlite:///./data/hr_assistant.db
STORAGE_DIR=./storage/resumes
MAX_UPLOAD_BYTES=15728640

# Optional SMTP delivery. A message is sent only after HR approves its draft.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Langfuse tracing is disabled when either key is empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

APP_NAME=HR Assistant API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Authentication. Production refuses to start while AUTH_SECRET_KEY is the
# public placeholder or shorter than 32 characters. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Leave unset for auto: Secure cookies everywhere except localhost. Set true or
# false explicitly (false helps on a LAN dev machine served over plain HTTP).
# AUTH_COOKIE_SECURE=

# Per-IP sliding-window limits (in-memory, one counter set per API worker).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_REFRESH_PER_MINUTE=60
RATE_LIMIT_PUBLIC_UPLOAD_PER_HOUR=5
RATE_LIMIT_CHAT_PER_MINUTE=30
# Trust X-Forwarded-For only behind a proxy that overwrites that header.
RATE_LIMIT_TRUST_PROXY=false

# Optional Google OAuth 2.0.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
OAUTH_FRONTEND_URL=http://localhost:3000/
